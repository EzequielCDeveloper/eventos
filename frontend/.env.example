# FiestaExpert frontend environment — copy to .env.local and fill in.
# Never commit real values. All values are read at build/run time via
# import.meta.env.VITE_* and are safe to stub in development (the dev
# proxy in vite.config.ts forwards /api, /uploads and /socket.io to the
# backend at http://localhost:3000).

# Base URL for the REST API. Leave empty to use the Vite dev proxy
# (same-origin). Example for a deployed backend:
# VITE_API_URL=https://api.fiestaexpert.mx/api/v1
VITE_API_URL=

# Conekta publishable (public) key used by Conekta.js to tokenize cards
# client-side. When empty, the payment step runs in simulated mode
# (matching the mockup "pago simulado") and never loads real card data.
VITE_CONEKTA_PUBLIC_KEY=

# Agora RTC app id for voice/video calls (S7 backend already exposes
# GET /api/v1/agora/token). Empty disables the call buttons.
VITE_AGORA_APP_ID=
