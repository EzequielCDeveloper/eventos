# Local development environment for the backend (never commit real values).
# Copy to .env and fill in your real values. Placeholders below boot the app in
# development mode; reserved keys became enforced only when NODE_ENV=production.

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (MariaDB 10.6+) ---
# Example local URL: mysql://user:pass@localhost:3306/eventos_db
DATABASE_URL=mysql://eventos_app:eventos_app_dev_pw@localhost:3306/eventos_db

# --- Auth ---
# Use a long random string in production (openssl rand -hex 32)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Redis (BullMQ job queue) ---
REDIS_URL=redis://localhost:6379

# --- External services (placeholder values; real keys arrive during the
# --- payments/realtime slices. Fail-fast only applies in production.) ---
CONEKTA_API_KEY=ck_live_placeholder
VERIFICAMEX_API_KEY=vmx_dev_placeholder
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"placeholder"}
RESEND_API_KEY=re_dev_placeholder
AGORA_APP_ID=agora_dev_placeholder
AGORA_APP_CERTIFICATE=agora_cert_placeholder

# --- Uploads (local disk storage) ---
UPLOAD_DIR=/data/uploads
SIGNED_URL_SECRET=dev-signed-url-secret