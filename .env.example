# =============================================================================
# FiestaExpert — root environment template (UR-005, D-010)
# Copy to `.env` and fill in real values. NEVER commit `.env` (see .gitignore).
# Placeholders are accepted by the backend outside NODE_ENV=production; in
# production the backend rejects placeholder-looking values (fail-fast).
#
# `docker compose config` requires DB_ROOT_PASSWORD and DB_PASSWORD to be set.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
# Ports exposed on the host (override if 80/443 are already taken).
HTTP_PORT=80
HTTPS_PORT=443
# Not exposed to the public; bound to localhost only (Nginx proxies it).
BACKEND_PORT=3000

# --- Database (MariaDB 10.6+) ---------------------------------------------
DB_DATABASE=eventos_db
# Root credentials (mariadb container).
DB_ROOT_PASSWORD=change-me-strong-root-password
# Application user credentials (used in DATABASE_URL for the backend).
DB_PASSWORD=change-me-strong-app-password

# --- Backend ---------------------------------------------------------------
# Auth (BR-002.7). Generate with `openssl rand -hex 32`.
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Signed URL secret for uploads (D-004, BR-013.6). Generate with
# `openssl rand -hex 32`. MUST match the value used everywhere.
SIGNED_URL_SECRET=change-me-use-openssl-rand-hex-32

# Job queue (BullMQ / D-011). Inside compose it is overridden to
# redis://redis:6379; keep localhost only for local (non-compose) runs.
REDIS_URL=redis://redis:6379

# --- External services (placeholders; real keys at integration time) -------
# Conekta (BR-006, BR-013.1): server secret + webhook verification.
CONEKTA_API_KEY=ck_live_placeholder
CONEKTA_WEBHOOK_SECRET=ck_whsk_placeholder
CONEKTA_WEBHOOK_PUBLIC_KEY=
# Verificamex (BR-010.5).
VERIFICAMEX_API_KEY=vmx_placeholder
VERIFICAMEX_API_URL=https://api.verificamex.mx/v1/verificar
# Firebase Cloud Messaging (BR-013.4) — service-account JSON, single line.
# When set in .env, keep it on one line and escape any double quotes if needed.
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"placeholder"}
# Resend email (BR-013.5).
RESEND_API_KEY=re_placeholder
RESEND_FROM=Plataforma Eventos <no-reply@eventos.app>
# Agora RTC (D-005).
AGORA_APP_ID=agora_placeholder
AGORA_APP_CERTIFICATE=agora_cert_placeholder

# --- Uploads ---------------------------------------------------------------
# Homogeneous path inside the backend container (named volume uploads_data).
UPLOAD_DIR=/data/uploads

# --- Frontend (VITE_* — baked into the bundle at build time, UR-005.2) -----
# Leave VITE_API_URL empty for the single-origin deployment (Nginx serves the
# SPA and proxies /api|/socket.io|/uploads on the same domain — D-010).
VITE_API_URL=
# Conekta publishable key for client-side card tokenization.
VITE_CONEKTA_PUBLIC_KEY=
# Agora app id for voice/video (leave empty to disable call buttons).
VITE_AGORA_APP_ID=
